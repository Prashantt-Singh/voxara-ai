# Voxara AI Backend Environment Variables
# Copy this file to .env and configure with your LiveKit credentials:
# cp .env.example .env

# LiveKit Server URL (Cloud or Self-Hosted)
# Example: wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key & Secret (found in your LiveKit Cloud project settings)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Default Room Name for user voice sessions
LIVEKIT_DEFAULT_ROOM=voxara-voice-room

# Google Gemini Live API Key (from Google AI Studio: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key

# Gemini Live Model & Voice Persona (Audio)
# Available models: gemini-2.5-flash-native-audio-preview-12-2025, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Available voices: Puck, Aoede, Fenrir, Leda, Charon, Kore
GEMINI_VOICE=Puck

# Gemini Text Generation Model (Skill Analysis Workflows)
# Supported models: gemini-3.7-flash, gemini-3.5-flash
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Primary Database Connection URL (PostgreSQL with asyncpg driver)
# Local PostgreSQL (development):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxara_ai

# Cloud PostgreSQL examples (Neon / Supabase):
# Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<ep-project-id>.<region>.aws.neon.tech/<dbname>?ssl=require
# Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require
