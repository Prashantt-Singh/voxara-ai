# Voxara AI Backend Environment Variables
# Copy this file to .env and configure with your LiveKit credentials:
# cp .env.example .env

# LiveKit Server URL (Cloud or Self-Hosted)
# Example: wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key & Secret (found in your LiveKit Cloud project settings)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Default Room Name for user voice sessions
LIVEKIT_DEFAULT_ROOM=voxara-voice-room

# Google Gemini Live API Key (from Google AI Studio: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key

# Gemini Live Model & Voice Persona (Audio)
# Available models: gemini-2.5-flash-native-audio-preview-12-2025, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Available voices: Puck, Aoede, Fenrir, Leda, Charon, Kore
GEMINI_VOICE=Puck

# Gemini Text Generation Model (Skill Analysis Workflows)
# Supported models: gemini-3.7-flash, gemini-3.5-flash
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Primary Database Connection URL (PostgreSQL with asyncpg driver)
# Local PostgreSQL (development):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxara_ai

# Cloud PostgreSQL examples (Neon / Supabase):
# Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<ep-project-id>.<region>.aws.neon.tech/<dbname>?ssl=require
# Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require

# Application Runtime Environment ('development', 'test', 'staging', 'production')
ENVIRONMENT=development

# Supabase Authentication & Cryptographic JWT Verification
# Whether to enforce strict Bearer authentication on protected endpoints (always True in production)
REQUIRE_AUTH=True

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
# Used to resolve public keys from the JWKS endpoint for asymmetric ES256/RS256 token verification
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase JWT Secret (from Supabase Dashboard > Project Settings > API > JWT Settings)
# Required for verifying symmetric HS256 token signatures
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional: Supabase JWKS URL (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional: Expected JWT audience claim (defaults to 'authenticated')
SUPABASE_JWT_AUDIENCE=authenticated

# Optional: Expected JWT issuer claim (defaults to ${SUPABASE_URL}/auth/v1 if set)
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Scheduled Opportunity Discovery & Persistent Notifications
# Master switch to enable scheduled background execution
SCHEDULER_ENABLED=true
# Set to false if running scheduled discovery as an external worker/cron job
ENABLE_IN_APP_SCHEDULER=true
# Sweep interval in minutes (default: 60 minutes)
SCHEDULER_INTERVAL_MINUTES=60
# Initial delay in seconds before first sweep on startup (default: 5)
SCHEDULER_INITIAL_DELAY_SECONDS=5
# Max opportunities fetched across Devpost, Simplify, Arbeitnow per run
DISCOVERY_BATCH_SIZE=30
# Days threshold to trigger approaching deadline notifications (default: 3)
DEADLINE_ALERT_DAYS=3
