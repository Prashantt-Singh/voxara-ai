# Frontend Environment Configuration
# Vite requires environment variables exposed to the client to be prefixed with VITE_

# voxara-ai backend API base URL
VITE_BACKEND_URL=http://localhost:8000

# Supabase Authentication Configuration (from voxara-auth dashboard -> Project Settings -> API)
# Do NOT put your service_role secret key or database password in frontend code!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
